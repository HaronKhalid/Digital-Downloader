{
  "manifest_version": 3,
  "name": "Digital Downloader",
  "version": "1.0.0",
  "description": "Send the video or link you are looking at to your Digital Downloader app with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send to Digital Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Send this page to Digital Downloader"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "digital-downloader@digitaltakhleeq.local",
      "strict_min_version": "121.0"
    }
  }
}