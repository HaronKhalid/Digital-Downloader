APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Leave empty to use ~/Downloads/PersonalMedia and ./data/temp
OUTPUT_DIRECTORY=
TEMP_DIRECTORY=

MAX_PARALLEL_JOBS=1
LOG_LEVEL=INFO

# Only needed if the frontend is served from a different origin. Never use "*".
CORS_ORIGINS=

# Sites handled by the media extractor (comma-separated, or '*' for any site).
ALLOWED_SOURCE_DOMAINS=youtube.com,youtu.be,instagram.com,instagr.am,facebook.com,fb.watch,fb.com,tiktok.com,twitter.com,x.com,reddit.com,pinterest.com,pin.it,vimeo.com,soundcloud.com,twitch.tv,threads.net,linkedin.com,dailymotion.com,bilibili.com,archive.org,streamable.com,bandcamp.com,tumblr.com,snapchat.com,bsky.app

# Largest single download allowed, in GB (1-500)
MAX_DOWNLOAD_GB=20

# Optional: custom path to ffmpeg binary (e.g. D:\Digital Takhleeq\Projects\personal-media-tool\bin\ffmpeg.exe) if not in PATH
FFMPEG_PATH=

